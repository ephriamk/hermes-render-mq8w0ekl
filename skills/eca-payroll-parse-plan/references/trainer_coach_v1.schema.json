{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eca-payroll.example.com/schemas/trainer_coach_v1.json",
  "title": "trainer_coach_v1",
  "description": "Authoritative JSON Schema for the parsed-output payload Hermes returns from a parse_comp_plan job whose plan_type is 'trainer_coach'. This schema is what the backend validates against before accepting /complete.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_meta",
    "session_commission",
    "class_pay",
    "bonuses",
    "policy_flags",
    "head_coach_addendum",
    "raw_extracted_text_summary",
    "parser_self_assessment"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trainer_coach_v1"
    },
    "plan_meta": { "$ref": "#/$defs/plan_meta" },
    "session_commission": { "$ref": "#/$defs/session_commission" },
    "class_pay": { "$ref": "#/$defs/class_pay" },
    "bonuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/bonus" }
    },
    "policy_flags": { "$ref": "#/$defs/policy_flags" },
    "head_coach_addendum": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/head_coach_addendum" }
      ]
    },
    "raw_extracted_text_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "parser_self_assessment": { "$ref": "#/$defs/parser_self_assessment" }
  },

  "$defs": {
    "plan_meta": {
      "type": "object",
      "required": [
        "plan_title",
        "effective_date",
        "region",
        "applies_to_positions",
        "document_revision",
        "source_filename"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_title": { "type": "string", "minLength": 1 },
        "effective_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO YYYY-MM-DD"
        },
        "region": { "type": "string", "minLength": 1 },
        "applies_to_positions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "document_revision": { "type": "string" },
        "source_filename": { "type": "string", "minLength": 1 }
      }
    },

    "session_commission": {
      "type": "object",
      "required": [
        "rate_table_type",
        "tiers",
        "pass_off_rate",
        "expired_session_rate",
        "graduated_pass_off_rules",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "rate_table_type": {
          "type": "string",
          "enum": ["tier_based", "flat", "hybrid"]
        },
        "tiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/session_tier" },
          "minItems": 1
        },
        "pass_off_rate": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "expired_session_rate": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "graduated_pass_off_rules": {
          "oneOf": [
            { "type": "null" },
            { "type": "object" }
          ]
        },
        "notes": { "type": "string" }
      }
    },

    "session_tier": {
      "type": "object",
      "required": [
        "tier",
        "label",
        "session_count_threshold",
        "rate_per_session",
        "applies_to"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "session_count_threshold": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum session count required to qualify for this tier."
        },
        "rate_per_session": { "type": "number", "minimum": 0 },
        "applies_to": {
          "type": "string",
          "enum": ["all_sessions", "regular_only", "pass_off_only"]
        }
      }
    },

    "class_pay": {
      "type": "object",
      "required": [
        "structure",
        "base_rate_per_class",
        "attendance_tiers",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "structure": {
          "type": "string",
          "enum": ["per_class_flat", "per_class_attendance_tiered", "salary", "none"]
        },
        "base_rate_per_class": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "attendance_tiers": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["min_attendees", "rate"],
                "additionalProperties": false,
                "properties": {
                  "min_attendees": { "type": "integer", "minimum": 0 },
                  "rate": { "type": "number", "minimum": 0 }
                }
              },
              "minItems": 1
            }
          ]
        },
        "notes": { "type": "string" }
      }
    },

    "bonus": {
      "type": "object",
      "required": [
        "bonus_name",
        "applies_to",
        "trigger",
        "trigger_threshold_amount",
        "trigger_threshold_metric",
        "payout_structure",
        "payout_value",
        "payout_cap",
        "frequency",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "bonus_name": { "type": "string", "minLength": 1 },
        "applies_to": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "trigger": { "type": "string" },
        "trigger_threshold_amount": {
          "oneOf": [
            { "type": "null" },
            { "type": "number" }
          ]
        },
        "trigger_threshold_metric": { "type": "string" },
        "payout_structure": {
          "type": "string",
          "enum": ["flat", "percent_of_metric", "tiered"]
        },
        "payout_value": { "type": "number" },
        "payout_cap": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "frequency": {
          "type": "string",
          "enum": ["monthly", "p2_only", "annual"]
        },
        "notes": { "type": "string" }
      }
    },

    "policy_flags": {
      "type": "object",
      "required": [
        "draw_eligible",
        "guarantee_eligible",
        "head_coach_eligible",
        "audit_score_required",
        "expired_sessions_paid",
        "pass_off_sessions_paid",
        "ct_included_sessions_paid",
        "split_session_pay_method",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "draw_eligible": { "type": "boolean" },
        "guarantee_eligible": { "type": "boolean" },
        "head_coach_eligible": { "type": "boolean" },
        "audit_score_required": { "type": "boolean" },
        "expired_sessions_paid": { "type": "boolean" },
        "pass_off_sessions_paid": { "type": "boolean" },
        "ct_included_sessions_paid": { "type": "boolean" },
        "split_session_pay_method": {
          "type": "string",
          "enum": ["split_evenly", "primary_takes_all", "see_addendum", "n/a"]
        },
        "notes": { "type": "string" }
      }
    },

    "head_coach_addendum": {
      "type": "object",
      "required": [
        "guarantee_amount",
        "guarantee_paid_in_table",
        "additional_responsibilities",
        "additional_pay",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "guarantee_amount": { "type": "number", "minimum": 0 },
        "guarantee_paid_in_table": {
          "type": "string",
          "enum": ["group_fitness", "personal_training", "split"]
        },
        "additional_responsibilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "additional_pay": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "notes": { "type": "string" }
      }
    },

    "parser_self_assessment": {
      "type": "object",
      "required": [
        "confidence",
        "warnings",
        "fields_extracted_directly",
        "fields_inferred",
        "fields_defaulted",
        "model_used"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fields_extracted_directly": { "type": "integer", "minimum": 0 },
        "fields_inferred": { "type": "integer", "minimum": 0 },
        "fields_defaulted": { "type": "integer", "minimum": 0 },
        "model_used": { "type": "string", "minLength": 1 }
      }
    }
  }
}
