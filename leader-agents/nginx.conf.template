# ECA leader agents: the front gate.
# Every request to a workspace is first shown to the supervisor (/_auth), which
# answers whose workspace the browser belongs to. The request then goes to that
# leader's relay socket, which only that leader's account serves.
user www-data;
worker_processes 2;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;                 # request lines can carry one-time tickets
  server_tokens off;
  client_max_body_size 32m;

  map $http_upgrade $connection_upgrade { default upgrade; "" close; }
  map $http_origin  $eca_origin  { "" ""; default "http://127.0.0.1:$agent_port"; }
  map $http_referer $eca_referer { "" ""; default "http://127.0.0.1:$agent_port/"; }

  # The supervisor listens on a private socket only nginx may open.
  upstream eca_supervisor { server unix:/run/eca/sup/sup.sock; }

  server {
    listen __PORT__ default_server;
    server_name _;
    absolute_redirect off;        # the public address is the host's, not this port

    # A workspace page must never register a service worker: on the one address all leaders
    # share, it could outlive a sign-out and read the next person's pages.
    if ($http_service_worker) { return 403; }

    location = /_eca/health      { default_type text/plain; return 200 "ok"; }

    location = /_auth {
      internal;
      proxy_pass http://eca_supervisor/_auth;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
    }

    location = /enter            { proxy_pass http://eca_supervisor; }
    location /_eca/static/       { alias /opt/eca/skin/; add_header Cache-Control "no-cache"; }
    # ECA's own agent screen (trial, alongside the engine's). Static files only; all data
    # it shows comes through the signed-in person's own workspace below.
    location = /ui { return 302 /ui/; }
    location /ui/test/ { return 404; }
    location /ui/ {
      alias /opt/eca/screen/;
      add_header Cache-Control "no-cache";
      add_header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://$host; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'";
      add_header X-Content-Type-Options nosniff;
    }
    location /_eca/vendor/       { alias /opt/eca-vendor/; add_header Cache-Control "public, max-age=86400"; }
    location /_eca/ {
      proxy_pass http://eca_supervisor;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_buffering off;          # the sign-in box is a live stream
      proxy_read_timeout 1200s;
    }

    # The workspace's own page: the usual rules, plus the ECA layer.
    location = / {
      include /opt/eca/nginx-workspace.inc;
      proxy_set_header Accept-Encoding "";
      sub_filter '</head>' '<link rel="stylesheet" href="/_eca/static/skin.css"><script src="/_eca/static/intro.js"></script><script src="/_eca/static/skin.js"></script><script src="/_eca/static/widgets.js"></script></head>';
      sub_filter_once on;
      proxy_pass http://unix:/run/eca/a/$agent_slug/web.sock;
    }

    location / {
      include /opt/eca/nginx-workspace.inc;
      proxy_pass http://unix:/run/eca/a/$agent_slug/web.sock;
    }
  }
}
