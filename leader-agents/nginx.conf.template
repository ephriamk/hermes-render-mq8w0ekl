# ECA leader agents: the front gate.
# Every request to a workspace is first shown to the supervisor (/_auth), which
# answers whose workspace the browser belongs to. The request then goes to that
# leader's relay socket, which only that leader's account serves.
user www-data;
worker_processes 2;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;                 # request lines can carry one-time tickets
  server_tokens off;
  client_max_body_size 32m;

  map $http_upgrade $connection_upgrade { default upgrade; "" close; }
  # The workspace is served as if to a browser on the same machine, so the
  # address headers a browser adds are rewritten to the workspace's own.
  map $http_origin  $eca_origin  { "" ""; default "http://127.0.0.1:$agent_port"; }
  map $http_referer $eca_referer { "" ""; default "http://127.0.0.1:$agent_port/"; }

  server {
    listen __PORT__ default_server;
    server_name _;

    location = /_auth {
      internal;
      proxy_pass http://127.0.0.1:9000/_auth;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
    }

    location = /enter            { proxy_pass http://127.0.0.1:9000; }
    location = /internal/verify  { proxy_pass http://127.0.0.1:9000; }
    location /_eca/static/       { alias /opt/eca/skin/; add_header Cache-Control "no-cache"; }
    location /_eca/diag/         { alias /run/eca/diag/; default_type text/plain; }
    location /_eca/              { proxy_pass http://127.0.0.1:9000; }

    location / {
      auth_request /_auth;
      auth_request_set $agent_slug $upstream_http_x_agent_slug;
      auth_request_set $agent_port $upstream_http_x_agent_port;
      error_page 401 = @signed_out;

      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:$agent_port;
      proxy_set_header Origin $eca_origin;
      proxy_set_header Referer $eca_referer;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      # Nothing about the outer hops is passed on.
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Forwarded-Host "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_set_header X-Forwarded-Port "";
      proxy_set_header X-Real-IP "";
      proxy_set_header Forwarded "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header CF-Visitor "";
      proxy_set_header Accept-Encoding "";

      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;

      sub_filter '</head>' '<link rel="stylesheet" href="/_eca/static/skin.css"><script src="/_eca/static/skin.js" defer></script></head>';
      sub_filter_once on;

      proxy_pass http://unix:/run/eca/a/$agent_slug/web.sock;
    }

    location @signed_out { return 302 /_eca/signed-out; }
  }
}
